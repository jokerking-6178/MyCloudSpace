# Environment variables required by the Spring Boot API.
#
# The database password no longer has a default — it was previously hardcoded in
# application.properties and committed. The app will refuse to start without it.
#
# Set these in your shell, your IDE run configuration, or a .env file your runner
# loads. They are read by src/main/resources/application.properties.

# --- database (required) ---
DB_URL=jdbc:postgresql://localhost:5432/my-cloud-space
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- jwt (required) ---
# Must be at least 32 bytes; startup fails fast with a clear message if it is shorter.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=36000000

# --- aws s3 (required) ---
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=

# --- github oauth (required for the GitHub sign-in button) ---
GITHUB_CLIENT=
GITHUB_SECRET=

# --- razorpay (required for the storage-upgrade flow) ---
RAZORPAY_KEY=
RAZORPAY_SECRET=

# --- optional overrides ---
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/redirect
# OLLAMA_BASE_URL=http://localhost:11434
# MAX_UPLOAD_SIZE=100MB
